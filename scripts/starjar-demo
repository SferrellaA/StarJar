#!/usr/bin/env python3
"""Walk a person through one challenge. The jar must be plugged in over USB.

If the challenge is not running, this installs it first. The jar joins an open
network. This script does not create that network. Leaving this script, by
any path, runs make clean. Unplug is still the attempt reset.
"""

from __future__ import annotations

import json
import select
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SSH = ROOT / "scripts" / "starjar-ssh"
INSTALL = ROOT / "scripts" / "starjar-install"
_hunting = False


def main() -> int:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("make demo needs this terminal", file=sys.stderr)
        return 1
    if not _reach():
        return 1
    code = 1
    try:
        code = _walk()
    except KeyboardInterrupt:
        print("\nstopped", flush=True)
        code = 130
    if not _clean():
        return code if code != 0 else 1
    return code


def _walk() -> int:
    global _hunting
    code, sid = _ensure_challenge()
    if code != 0:
        return code

    print("This is the operator walkthrough, over the USB cable.", flush=True)
    print("The jar does not host the network. You create it.", flush=True)
    print(flush=True)
    status = _status()
    if status.get("stage") != "phase1" and not status.get("associated"):
        print("Starting the hunt disconnects the jar's Wi-Fi.", flush=True)
        print("This USB shell stays up. A Wi-Fi login would die.", flush=True)
        if not _ask("Start the hunt now?", default_yes=True):
            print("The jar is not trying to connect.", flush=True)
            return 0
        _hunting = True
        _ssh("rm -f /run/starjar/hold")
        warned = _ssh("/usr/local/bin/jump phase1")
        if warned.stderr.strip():
            print(warned.stderr.strip(), flush=True)
        if warned.returncode != 0:
            print("could not start the hunt", file=sys.stderr)
            return 1
    elif status.get("stage") in {"phase1", "phase2"}:
        _hunting = True

    print(flush=True)
    print("The jar is trying to connect to this open network:", flush=True)
    print(flush=True)
    print(f"    {sid}", flush=True)
    print(flush=True)
    print("Create that network yourself, with no password.", flush=True)
    print("A phone hotspot often refuses an open network.", flush=True)
    print("A spare router, or an access point on another computer, is the reliable way.", flush=True)
    print("This computer can host it only if that does not take down the USB shell.", flush=True)
    print(flush=True)
    print("Waiting until the jar joins. Enter or Ctrl-C stops and cleans the jar.", flush=True)
    joined = _wait_until_joined()
    if not joined:
        print("Stopped before the jar joined.", flush=True)
        return 0

    port = _port()
    address = _wlan_address()
    print(flush=True)
    code = _ssh("cat /run/starjar/code").stdout.strip()
    print("The jar joined. The strip is now spelling this code:", flush=True)
    print(flush=True)
    print(f"    {code or '(the jar has no phase-two code)'}", flush=True)
    print(flush=True)
    print("That code is not on the page. /debug names the stage and does not contain it.", flush=True)
    if address:
        print(f"On the network you created, open http://{address}:{port}", flush=True)
    else:
        print(f"On the network you created, the jar serves port {port}.", flush=True)
        print("It does not have an IPv4 address on wlan0 yet.", flush=True)
    print("A phone on that network can solve the page. The USB address is not the player path.", flush=True)
    print("The page names a list. The challenge tree has a backup of the routes.", flush=True)
    print("The strip's code is what that path wants.", flush=True)
    print(flush=True)
    print("After the code is accepted, the page says to ask someone who was there.", flush=True)
    print("That set is /var/lib/starjar/trivia.toml on the jar. It is not in git.", flush=True)
    print("Unplugging resets the attempt. The scoreboard stays.", flush=True)
    print("Ending this walkthrough uninstalls the challenge and clears the jar.", flush=True)
    print(flush=True)
    input("Press enter to stop and clean the jar. ")
    return 0


def _ensure_challenge() -> tuple[int, str]:
    """Return an exit code and the SID. Install only if the challenge is down."""

    if _running():
        sid = _sid()
        if sid:
            return 0, sid
    print("Installing the challenge.", flush=True)
    installed = subprocess.run([str(INSTALL)], check=False)
    if installed.returncode != 0:
        if installed.returncode != 253:
            print("could not install the challenge", file=sys.stderr)
        return installed.returncode, ""
    sid = _wait_sid()
    if not sid:
        print("The challenge did not come up.", file=sys.stderr)
        return 1, ""
    return 0, sid


def _running() -> bool:
    return _ssh("systemctl is-active --quiet starjar.service").returncode == 0


def _sid() -> str:
    result = _ssh("cat /run/starjar/sid")
    if result.returncode != 0:
        return ""
    return result.stdout.strip()


def _wait_sid() -> str:
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        sid = _sid()
        if sid:
            return sid
        time.sleep(0.4)
    return ""


def _clean() -> bool:
    """Turn the strip off, then make clean. Every demo exit comes through here."""

    print("Cleaning the jar.", flush=True)
    _ssh("/usr/local/bin/jump idle", timeout=20)
    result = subprocess.run(["make", "-C", str(ROOT), "clean"], check=False)
    if result.returncode != 0:
        print("could not clean the jar", file=sys.stderr)
        return False
    return True


def _reach() -> bool:
    result = subprocess.run(
        [str(SSH), "true"],
        check=False,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        timeout=40,
    )
    if result.returncode == 0:
        return True
    # 253: USB gadget is up, ssh is not. starjar-shell already wrote the sentence.
    if result.returncode == 253:
        print(
            result.stderr.strip()
            or "the jar is visible, but it is probably restarting. that takes a few minutes.",
            file=sys.stderr,
        )
        return False
    print("The jar is not reachable over USB. Plug it in and retry.", file=sys.stderr)
    return False


def _ssh(command: str, timeout: int = 40) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [str(SSH), command],
        check=False,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=timeout,
    )


def _text(command: str) -> str:
    result = _ssh(command)
    if result.returncode != 0:
        detail = result.stderr.strip() or "remote command failed"
        raise SystemExit(detail)
    return result.stdout


def _status() -> dict:
    raw = _text("/usr/local/bin/jump status")
    payload = json.loads(raw)
    if not isinstance(payload, dict):
        raise SystemExit("jump status")
    return payload


def _wait_until_joined() -> bool:
    while True:
        try:
            status = _status()
        except SystemExit:
            status = {}
        if status.get("associated") and status.get("stage") == "phase2":
            return True
        readable, _, _ = select.select([sys.stdin], [], [], 2)
        if readable:
            sys.stdin.readline()
            return False


def _port() -> str:
    raw = _text(
        "python3 -c 'import tomllib; "
        "print(tomllib.load(open(\"/etc/starjar/config.toml\",\"rb\"))[\"web\"][\"port\"])'"
    ).strip()
    return raw or "8080"


def _wlan_address() -> str:
    text = _ssh("ip -4 -o addr show dev wlan0").stdout
    for token in text.split():
        if token.count(".") == 3 and "/" in token:
            return token.split("/", 1)[0]
    return ""


def _ask(prompt: str, default_yes: bool) -> bool:
    suffix = " [Y/n] " if default_yes else " [y/N] "
    answer = input(prompt + suffix).strip().lower()
    if not answer:
        return default_yes
    return answer in {"y", "yes"}


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nstopped", flush=True)
        raise SystemExit(130) from None
